{
  "name": "react-native-phone-input-kit",
  "version": "1.0.0",
  "description": "A modern, highly customizable, and validated React Native phone number input component with international country selector and search.",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf lib",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "react-native-component",
    "phone-input",
    "phone-number",
    "country-picker",
    "country-code",
    "international-phone-input",
    "libphonenumber",
    "typescript",
    "ios",
    "android",
    "react-native-phone-input-kit"
  ],
  "author": "Jenil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenilizonnet/phoneinput_npm.git"
  },
  "bugs": {
    "url": "https://github.com/jenilizonnet/phoneinput_npm/issues"
  },
  "homepage": "https://github.com/jenilizonnet/phoneinput_npm#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.68.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.17"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.79",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}

